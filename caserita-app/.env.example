# Variables de la API de Caserita (se cargan en Vercel > Settings > Environment Variables)

# Postgres (Vercel > Storage > Create Database > Neon la inyecta sola con este nombre)
DATABASE_URL=

# Bot de Telegram que recibe los comprobantes con los botones Aceptar / Rechazar
TELEGRAM_BOT_TOKEN=
# Chat donde llegan (escribe /id al bot después de configurar el webhook y te lo dice)
TELEGRAM_CHAT_ID=
# Cualquier texto largo al azar: Telegram lo devuelve en cada llamada al webhook
TELEGRAM_WEBHOOK_SECRET=

# Clave de administrador: firma los tokens de las caseras y protege /api/admin y /api/telegram/configurar
CASERITA_SECRETO=

# Dominio público, para registrar el webhook
APP_URL=https://www.caserita.shop
